# No API key is needed to talk to a local Ollama.
# Optional: protect the bridge itself with a Bearer key (leave empty to disable).
OLLAMA_RERANK_BRIDGE_API_KEY=
# Optional: force the CLI language (en or ko).
OLLAMA_RERANK_BRIDGE_LANG=
# Ollama address (same rule as Ollama itself: host:port).
OLLAMA_HOST=127.0.0.1:11434
